# Malachi Wealth works with NO keys: prices, charts, option chains and news come from Yahoo Finance,
# and Trump's posts come from a public Truth Social mirror plus Trump headlines.
# Copy this file to .env.local and fill in any keys you have to upgrade a feed.

# Trump's posts straight from X (needs an X API plan that can read user timelines, Basic or higher).
X_BEARER_TOKEN=

# Finnhub (free tier) adds a second, faster company-news source. https://finnhub.io/register
FINNHUB_API_KEY=

# Set to 1 to force demo data (useful offline).
MALACHI_DEMO=

# Real option flow (sweeps, blocks, unusual activity) from Unusual Whales. https://unusualwhales.com/public-api
# Without it, the Option flow tab estimates flow from option-chain snapshots.
UNUSUAL_WHALES_API_KEY=
